#!/usr/bin/env bash
# omarchy-x-panel — Opera-GX style always-on X (Twitter) side panel for Omarchy.
#
# The panel IS your existing X (Twitter) window — never a second Chromium
# instance (that would be the "enredo" of two separate logins). If an X window is
# already open it is reused; otherwise one is launched with your native profile.
#   * pinned (visible on every workspace) and floating at a configurable position/size
#   * toggled from the bar icon or SUPER+SHIFT+X: show / hide WITHOUT closing,
#     so the session and scroll position are preserved.
#
# Layout is computed against the SAFE AREA: the monitor minus the Quickshell bar
# strip (top or bottom), so the panel never covers the bar and respects a gap.
# Identity is tracked as "address|pid". Preferences live in prefs.json under
# $XDG_CONFIG_HOME (so they survive reboots) and are applied live via
# `set-pref <key> <value>`.

set -uo pipefail

X_URL="https://x.com/"
# Portable: derive the plugin dir from this script's own location (bin/ -> plugin root),
# so it works after `omarchy plugin add` on any machine, not just this one.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PLUGIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PROFILE="${CHROMIUM_PROFILE:-$HOME/.config/chromium}"
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
# Prefs must outlive the session: $XDG_RUNTIME_DIR is a tmpfs wiped on every
# logout/reboot, which silently reset size and position. They live outside the
# plugin directory so writing them never triggers a plugin reload.
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-x-panel"
PREFS="$CONFIG_DIR/prefs.json"
LEGACY_PREFS="$RUNDIR/omarchy-x-panel.prefs.json"   # pre-1.1 location, read once to migrate
STATE="$RUNDIR/x-panel.state"   # stores "address|pid"
HIDDEN_AT="$RUNDIR/x-panel.hidden-at"   # epoch seconds of the last hide
STRIKES="$RUNDIR/x-panel.strikes"       # consecutive unhealthy watchdog checks
LAST_RELOAD="$RUNDIR/x-panel.last-reload"   # epoch seconds of the last watchdog trigger
PENDING="$RUNDIR/x-panel.reload-pending"    # watchdog asked for a reload on next focus

export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -1 "$RUNDIR"/hypr/ 2>/dev/null | grep -E '^[0-9a-f]{8}' | head -1)}"
export XDG_RUNTIME_DIR="$RUNDIR"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

# ---- safe reads (G12 hardened) ---------------------------------------------
# Every external read goes through one of these helpers. They refuse symlinks
# to special files / FIFOs, cap size at 256 KiB, and enforce a deadline. A
# return of "" means "unreadable / unsafe / too large" — never a hang or an
# unbounded slurp of another user's runtime namespace.
MAX_READ=262144
# Open once with O_NOFOLLOW | O_NONBLOCK, verify via fstat, and read from that
# exact descriptor. This closes the TOCTOU gap where the path is checked, then
# replaced by a symlink/FIFO/special file before the actual read. Returns empty
# and exit 1 if anything looks unsafe or too large.
read_file_safe() {
  local f="$1"
  python3 - "$f" "$MAX_READ" <<'PY'
import os, sys, stat
path, maxb = sys.argv[1], int(sys.argv[2])
try:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except Exception:
    sys.exit(1)
try:
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_size > maxb:
        sys.exit(1)
    data = os.read(fd, maxb)
    if len(data) > maxb:
        sys.exit(1)
    sys.stdout.buffer.write(data)
finally:
    os.close(fd)
PY
}
hypr_json() {                      # run a hyprctl -j query, read it safely
  local tmp; tmp=$(mktemp -p "$RUNDIR") || { printf ''; return 1; }
  if timeout 5 "$@" > "$tmp" 2>/dev/null; then
    read_file_safe "$tmp"
  fi
  rm -f "$tmp"
}

SPECIAL="special:sidepanelX"
# Omarchy webapp window classes are <browser>-<host><path>-<profile>, so both
# the browser prefix and the profile suffix vary with the user's setup: Brave
# gives brave-x.com__-Default, a secondary profile gives ...-Profile_2. Match
# on a regex rather than one hardcoded string.
X_CLASS="^(chrome|chromium|brave)-x\\.com__.*"
BAR_NS="omarchy-bar"
GAP=8

# ---- prefs ----------------------------------------------------------------
# width/height are the defaults for any monitor; `monitors` holds per-monitor
# overrides keyed by monitor_key (a laptop panel and an external screen with a
# different scale rarely want the same size).
default_prefs() { echo '{"side":"right","valign":"top","width":420,"height":"75%","refresh":60,"watchdog":true,"autohide":false,"monitors":{}}'; }
read_prefs() {
  local raw; raw=$(read_file_safe "$PREFS")
  [ -n "$raw" ] || raw=$(read_file_safe "$LEGACY_PREFS")
  # Merge over the defaults so keys added in later versions always resolve.
  if [ -n "$raw" ]; then printf '%s' "$raw" | jq -c --argjson d "$(default_prefs)" '$d + .' 2>/dev/null || default_prefs
  else default_prefs; fi
}
# write_prefs_jq <filter> [jq args...]: apply a jq filter to the prefs.
write_prefs_jq() {
  local cur; cur=$(read_prefs)
  # Refuse a symlinked config dir (G12): the write must land where we think.
  [ -L "$CONFIG_DIR" ] && return 1
  mkdir -p -m 700 "$CONFIG_DIR" 2>/dev/null || return 1
  local tmp; tmp=$(mktemp -p "$CONFIG_DIR") || return 1
  local filter="$1"; shift
  if echo "$cur" | jq "$@" "$filter" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$PREFS"
  else
    rm -f "$tmp"
    return 1
  fi
}
write_prefs() { write_prefs_jq '. + {($k): $v}' --arg k "$1" --argjson v "$2"; }
# write_monitor_size <monitor-key> <key> <json-value>: per-monitor override,
# also kept as the global default so a monitor seen for the first time starts
# from the last size chosen anywhere.
write_monitor_size() {
  write_prefs_jq '.monitors = ((.monitors // {}) | .[$m] = ((.[$m] // {}) + {($k): $v})) | .[$k] = $v' \
    --arg m "$1" --arg k "$2" --argjson v "$3"
}

# One-time move of pre-1.1 prefs out of the tmpfs, before the next reboot
# wipes them. Goes through write_prefs, so it gets the same safe write path.
migrate_prefs() {
  [ -e "$PREFS" ] && return 0
  local raw; raw=$(read_file_safe "$LEGACY_PREFS")
  [ -n "$raw" ] || return 0
  write_prefs side "$(printf '%s' "$raw" | jq -c '.side // "right"' 2>/dev/null || echo '"right"')" \
    && rm -f "$LEGACY_PREFS"
}

# Atomic state-file write (exclusive temp in same dir, then mv -f) — G12.
write_state() {
  local tmp; tmp=$(mktemp -p "$RUNDIR")
  echo "$1" > "$tmp" && mv -f "$tmp" "$STATE"
}
pref() { read_prefs | jq -r --arg k "$1" '.[$k]'; }

# ---- hyprland helpers -----------------------------------------------------
find_x() {
  hypr_json hyprctl clients -j 2>/dev/null | jq -r --arg c "$X_CLASS" \
    '.[] | select((.class // "") | test($c)) | "\(.address)|\(.pid)"' | head -n1 || true
}
addr_alive() {
  local a="$1"; [ -z "$a" ] && return 1
  # Boolean: the exit code drives `resolve`, so NO `|| true` here (that would
  # make it always-true and reuse a dead address).
  hypr_json hyprctl clients -j 2>/dev/null | jq -e --arg a "$a" '.[] | select(.address==$a)' >/dev/null 2>&1
}
pid_alive() { local p="$1"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }
resolve() {
  local saved="$1" a p cur
  a="${saved%%|*}"; p="${saved##*|}"
  if addr_alive "$a"; then echo "$a|$p"; return; fi
  if pid_alive "$p"; then
    # Chromium shares the browser pid across windows, so the pid lookup MUST
    # also match the X class — otherwise we adopt a non-X Chromium window.
    cur=$(hypr_json hyprctl clients -j 2>/dev/null | jq -r --arg p "$p" --arg c "$X_CLASS" '.[] | select(.pid==($p|tonumber) and ((.class // "") | test($c))) | "\(.address)|\(.pid)"' | head -n1 || true)
    [ -n "$cur" ] && { echo "$cur"; return; }
  fi
  cur=$(find_x); [ -n "$cur" ] && { echo "$cur"; return; }
  echo ""
}
is_pinned() {
  local a="$1"; hypr_json hyprctl clients -j 2>/dev/null | jq -r --arg a "$a" '.[] | select(.address==$a) | .pinned' | head -n1 || true
}

# Chromium puts X's unread-notification count at the start of the webapp title,
# e.g. "(3) Inicio / X". Reading the compositor title keeps this lightweight:
# no second browser, API token, or browser-profile access is needed.
unread_count() {
  local title
  title=$(hypr_json hyprctl clients -j 2>/dev/null | jq -r --arg c "$X_CLASS" \
    '.[] | select((.class // "") | test($c)) | .title // ""' | head -n1 || true)
  if [[ "$title" =~ ^\(([0-9][0-9,]*)\) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]//,/}"
  else
    printf '0\n'
  fi
}
state_of() {
  local ap="$1" a="${1%%|*}"
  addr_alive "$a" || { echo "gone"; return; }
  local ws
  ws=$(hypr_json hyprctl clients -j 2>/dev/null | jq -r --arg a "$a" '.[] | select(.address==$a) | .workspace.name' || true)
  case "$ws" in
    "$SPECIAL") echo "hidden" ;;
    *) echo "visible" ;;
  esac
}

hl_move()   { hyprctl dispatch "hl.dsp.window.move({ window = \"address:$1\", workspace = \"$2\", follow = $3 })" >/dev/null 2>&1; }
hl_float()  { hyprctl dispatch "hl.dsp.window.float({ window = \"address:$1\" })" >/dev/null 2>&1; }   # toggles pin
hl_pin()    { hyprctl dispatch "hl.dsp.window.pin({ window = \"address:$1\" })" >/dev/null 2>&1; }   # toggles pin
hl_resize() { hyprctl dispatch "hl.dsp.window.resize({ window = \"address:$1\", x = $2, y = $3 })" >/dev/null 2>&1; }
hl_movepos(){ hyprctl dispatch "hl.dsp.window.move({ window = \"address:$1\", x = $2, y = $3 })" >/dev/null 2>&1; }
hl_focus()  { hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null 2>&1; }

ensure_pin() {
  local a="$1" want="$2" cur
  cur=$(is_pinned "$a")
  if [ "$cur" != "$want" ]; then hl_pin "$a"; fi
}

is_floating() {
  local a="$1"; hypr_json hyprctl clients -j 2>/dev/null | jq -r --arg a "$a" '.[] | select(.address==$a) | .floating' | head -n1 || true
}
ensure_float() {
  local a="$1" cur
  cur=$(is_floating "$a")
  if [ "$cur" != "true" ]; then hl_float "$a"; fi
}

# The focused monitor, not blindly the first one in hyprctl's list.
MON_SELECT='if type=="array" then ((map(select(.focused)) | .[0]) // .[0]) else . end'
# One snapshot of the focused monitor: "name x y w h" — origin in absolute
# layout coordinates, size in logical px. Hyprland positions windows in
# absolute coordinates, so a position computed relative to the monitor has to
# be shifted by the origin before it is dispatched.
# Optional $1 = monitor id, to target the monitor a window is on rather than
# the focused one. The trailing field is monitor_key: the EDID description
# when there is one (so two different screens plugged into the same HDMI port
# keep separate sizes), else the connector name (laptop panels have none).
monitor_geom() {
  local sel="$MON_SELECT"
  [[ "${1:-}" =~ ^[0-9]+$ ]] && sel="if type==\"array\" then ((map(select(.id == $1)) | .[0]) // .[0]) else . end"
  hypr_json hyprctl monitors -j 2>/dev/null | jq -r "$sel"' | "\(.name) \(.x) \(.y) \(.width / (.scale // 1) | floor) \(.height / (.scale // 1) | floor) \(if (.description // "") != "" then .description else .name end)"' 2>/dev/null || true
}
focused_monitor_key() { local g; g=$(monitor_geom); g="${g#* * * * * }"; echo "$g"; }
# Effective "width height" prefs for monitor key $1.
size_for() {
  read_prefs | jq -r --arg m "$1" '(.monitors[$m] // {}) as $o | "\($o.width // .width) \($o.height // .height)"'
}

# Quickshell bar strip geometry on monitor $1: "barY barH" in absolute logical
# px (or "0 0" if not found). Every monitor has its own omarchy-bar layer, so
# the lookup MUST be scoped to the target monitor — taking the first one made
# the panel cover the bar on any other screen. Works whether the bar is on the
# top or the bottom edge.
bar_geom() {
  local line
  line=$(hypr_json hyprctl layers -j 2>/dev/null | jq -r --arg m "$1" --arg ns "$BAR_NS" \
    '[(.[$m].levels // {})[][] | select(.namespace == $ns)] | .[0] // empty | "\(.y) \(.h)"' 2>/dev/null | head -n1 || true)
  echo "${line:-0 0}"
}

# Safe area (logical px) = monitor minus the bar strip, with a gap.
# Echoes "sy sh" (start-y, height of the usable area).
safe_area() {
  local mw="$1" mh="$2" by="$3" bh="$4" sy sh
  if [ "$bh" -le 0 ]; then echo "0 $mh"; return; fi
  if [ "$by" -lt $(( mh / 2 )) ]; then
    # bar at top: usable area starts below the bar
    sy=$(( by + bh + GAP ))
    sh=$(( mh - sy ))
  else
    # bar at bottom: usable area ends above the bar
    sy=$GAP
    sh=$(( by - GAP ))
  fi
  [ "$sh" -lt 40 ] && sh=40
  echo "$sy $sh"
}

px_value() {
  local raw="$1" dim="$2" ref="$3"
  if [[ "$raw" == *% ]]; then
    echo "$(( ref * ${raw%\%} / 100 ))"
  else
    echo "$raw"
  fi
}

# Compute x|y in logical px. $5 = safe-area start-y, $6 = safe-area height, $7 = height.
compute_xy() {
  local side="$1" valign="$2" mw="$3" w="$4" sy="$5" sh="$6" h="$7" x y
  case "$side" in
    left)   x=20 ;;
    center) x=$(( (mw - w) / 2 )) ;;
    right)  x=$(( mw - w - 20 )) ;;
    *)      x=$(( mw - w - 20 )) ;;
  esac
  case "$valign" in
    top)    y=$sy ;;
    bottom) y=$(( sy + sh - h )) ;;
    center) y=$(( sy + (sh - h) / 2 )) ;;
    *)      y=$sy ;;
  esac
  echo "$x|$y"
}

# apply_layout <address|pid> [monitor-id]: default is the focused monitor.
apply_layout() {
  local ap="$1" a="${1%%|*}" side valign w h mn mw mh mx my mk bg by bh sa sy sh x y sz
  side=$(pref side); valign=$(pref valign)
  read -r mn mx my mw mh mk <<< "$(monitor_geom "${2:-}")"
  [ -n "$mh" ] || return 1
  bg=$(bar_geom "$mn"); by="${bg%% *}"; bh="${bg##* }"
  # hyprctl layers reports the bar in absolute coordinates; safe_area reasons
  # in monitor-relative ones.
  by=$(( by - my ))
  sa=$(safe_area "$mw" "$mh" "$by" "$bh"); sy="${sa%% *}"; sh="${sa##* }"
  sz=$(size_for "$mk")
  w=$(px_value "${sz%% *}" w "$mw")
  h=$(px_value "${sz##* }" h "$sh")
  # A free-dragged size saved on a bigger screen must still fit this one.
  [ "$w" -gt $(( mw - 40 )) ] && w=$(( mw - 40 ))
  [ "$h" -gt "$sh" ] && h=$sh
  # recompute y with real h
  case "$valign" in
    top)    y=$sy ;;
    bottom) y=$(( sy + sh - h )) ;;
    center) y=$(( sy + (sh - h) / 2 )) ;;
    *)      y=$sy ;;
  esac
  case "$side" in
    left)   x=20 ;;
    center) x=$(( (mw - w) / 2 )) ;;
    right)  x=$(( mw - w - 20 )) ;;
    *)      x=$(( mw - w - 20 )) ;;
  esac
  [ "$y" -lt 0 ] && y=0
  # Back into absolute layout coordinates for the dispatch.
  x=$(( x + mx )); y=$(( y + my ))
  hl_resize "$a" "$w" "$h"; hl_movepos "$a" "$x" "$y"
}

launch_or_reuse() {
  local ap; ap=$(find_x)
  if [ -z "$ap" ]; then
    # Launch EXACTLY like the Omarchy launcher (SUPER+SPACE -> Apps -> X): run the
    # .desktop file via uwsm-app. Never wrap omarchy-launch-webapp in another
    # `setsid uwsm-app --` — the double wrap eats the --app arg and opens a plain
    # empty browser window instead of the webapp.
    if [ -f "$HOME/.local/share/applications/X.desktop" ] || [ -f /usr/share/applications/X.desktop ]; then
      ( uwsm-app -- X.desktop >/dev/null 2>&1 & )
    else
      ( omarchy-launch-webapp "$X_URL" >/dev/null 2>&1 & )
    fi
    for _ in $(seq 1 40); do
      sleep 0.3; ap=$(find_x); [ -n "$ap" ] && break
    done
  fi
  if [ -z "$ap" ]; then echo "failed to launch X window" >&2; rm -f "$STATE"; exit 1; fi
  write_state "$ap"
  apply_layout "$ap"
  ensure_float "${ap%%|*}"
  ensure_pin "${ap%%|*}" true
}

# Reload the X page (F5) in the panel window only. Long-lived X tabs keep
# growing (infinite timeline, media, websocket state) until they crawl or
# crash; a reload returns them to a fresh baseline without losing the login.
# Hyprland only delivers the key to the FOCUSED window, so callers focus the
# panel first.
reload_window() {
  local a="$1"
  hyprctl dispatch "hl.dsp.send_key_state({ mods = \"\", key = \"F5\", state = \"down\", window = \"address:$a\" })" >/dev/null 2>&1 || return 1
  sleep 0.05
  hyprctl dispatch "hl.dsp.send_key_state({ mods = \"\", key = \"F5\", state = \"up\", window = \"address:$a\" })" >/dev/null 2>&1
}

# Auto-refresh on show: only when the panel has been HIDDEN for at least
# `refresh` minutes (0 = off). Nobody hides X mid-sentence and comes back an
# hour later expecting the draft, while a tab left for hours is exactly the
# one that degrades — so idle time is the safe proxy for "nothing written".
# Returns 0 only if it reloaded.
maybe_refresh() {
  local a="$1" mins since
  since=$(num_file "$HIDDEN_AT"); rm -f "$HIDDEN_AT"
  mins=$(pref refresh); [[ "$mins" =~ ^[0-9]+$ ]] && [ "$mins" -gt 0 ] || return 1
  [ "$since" -gt 0 ] && [ $(( $(date +%s) - since )) -ge $(( mins * 60 )) ] || return 1
  reload_window "$a"
}
# Consume a watchdog-flagged reload (the panel has just got focus).
reload_if_pending() {
  [ -e "$PENDING" ] || return 1
  rm -f "$PENDING"
  reload_window "$1"
}
# On show, a page that is visibly broken is reloaded right away.
reload_if_broken() {
  local a="$1" title
  [ "$(pref watchdog)" = "false" ] && return 0
  title=$(window_field "$a" title)
  [ -n "$title" ] && ! title_healthy "$title" && reload_window "$a"
}

# A loaded X page always titles itself "<page> / X" (optionally prefixed by an
# unread count). Anything else for minutes on end — a bare host or URL from a
# network error page, a stuck "X" splash — means the tab is broken.
title_healthy() { [[ "$1" == *" / X" ]]; }
window_field() {
  hypr_json hyprctl clients -j 2>/dev/null | jq -r --arg a "$1" --arg f "$2" '.[] | select(.address==$a) | .[$f] | tostring' | head -n1 || true
}
num_file() { local v; v=$(read_file_safe "$1" | tr -d '[:space:]'); [[ "$v" =~ ^[0-9]+$ ]] && echo "$v" || echo 0; }
write_num() { local tmp; tmp=$(mktemp -p "$RUNDIR") && echo "$2" > "$tmp" && mv -f "$tmp" "$1"; }

# Watchdog, polled by the bar widget once a minute. After three consecutive
# unhealthy titles it flags a reload, done the next time the panel is shown or
# focused: the key can only reach a focused window, and stealing focus from
# whatever you are typing in would be worse than a broken hidden tab. Never
# while the panel has focus (you would see it, and you might be typing), and
# at most once every 10 minutes so an offline machine does not loop.
watchdog() {
  [ "$(pref watchdog)" = "false" ] && return 0
  local saved ap a title strikes now
  saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved"); a="${ap%%|*}"
  [ -n "$a" ] || return 0
  title=$(window_field "$a" title)
  if [ -z "$title" ] || title_healthy "$title"; then rm -f "$STRIKES"; return 0; fi
  [ "$(window_field "$a" focusHistoryID)" = "0" ] && return 0
  strikes=$(( $(num_file "$STRIKES") + 1 ))
  now=$(date +%s)
  if [ "$strikes" -ge 3 ] && [ $(( now - $(num_file "$LAST_RELOAD") )) -ge 600 ]; then
    write_num "$PENDING" "$now" && write_num "$LAST_RELOAD" "$now"
    rm -f "$STRIKES"
  else
    write_num "$STRIKES" "$strikes"
  fi
}

show_window() {
  local ap="$1" a="${1%%|*}"
  hl_move "$a" "+0" true
  ensure_float "$a"
  ensure_pin "$a" true
  apply_layout "$ap"
  hl_focus "$a"
  reload_if_pending "$a" || maybe_refresh "$a" || reload_if_broken "$a"
}
# Reveal without stealing focus — used while the preferences panel is open so it
# keeps focus and stays up while you preview changes.
reveal_window() {
  local ap="$1" a="${1%%|*}"
  hl_move "$a" "+0" true
  ensure_float "$a"
  ensure_pin "$a" true
}
hide_window() {
  local ap="$1" a="${1%%|*}"
  ensure_pin "$a" false
  hl_move "$a" "$SPECIAL" false
  local tmp; tmp=$(mktemp -p "$RUNDIR") && date +%s > "$tmp" && mv -f "$tmp" "$HIDDEN_AT"
}

# Panel geometry for the bar widget's resize grips, as one JSON line. x/y are
# relative to the window's own monitor, whose origin is in mx/my. "visible"
# means shown as the panel: pinned, floating, outside the hidden workspace.
geom_json() {
  local saved ap a clients mons
  saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved"); a="${ap%%|*}"
  if [ -z "$a" ]; then echo '{"visible":false}'; return; fi
  clients=$(hypr_json hyprctl clients -j); mons=$(hypr_json hyprctl monitors -j)
  jq -cn --argjson c "${clients:-[]}" --argjson m "${mons:-[]}" --argjson p "$(read_prefs)" \
    --arg a "$a" --arg sp "$SPECIAL" '
    ($c | map(select(.address == $a)) | .[0]) as $w
    | if $w == null or $w.workspace.name == $sp or ($w.pinned | not) or ($w.floating | not)
      then {visible: false, address: $a}
      else ($m | map(select(.id == $w.monitor)) | .[0]) as $mo
      | {visible: true, address: $a, monitor: $mo.name, mx: $mo.x, my: $mo.y,
         x: ($w.at[0] - $mo.x), y: ($w.at[1] - $mo.y), w: $w.size[0], h: $w.size[1],
         focused: ($w.focusHistoryID == 0),
         side: $p.side, valign: $p.valign}
      end' 2>/dev/null || echo '{"visible":false}'
}

# set-size <w> <h>: persist a size dragged with the grips for the monitor the
# panel is on, then re-anchor it there.
set_size() {
  local w="$1" h="$2" saved ap a mid mk
  [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || return 1
  saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved"); a="${ap%%|*}"
  [ -n "$a" ] || return 1
  mid=$(window_field "$a" monitor)
  mk=$(monitor_geom "$mid"); mk="${mk#* * * * * }"
  [ -n "$mk" ] || return 1
  write_monitor_size "$mk" width "$w" && write_monitor_size "$mk" height "$h"
  apply_layout "$ap" "$mid"
}

# hide-if-blurred <address>: focus moved to window $1 (from the widget's
# activewindowv2 hook). Hide the panel unless that window is another X window
# or a file-chooser portal opened from X (picking an image to post).
hide_if_blurred() {
  [ "$(pref autohide)" = "true" ] || return 0
  local to="${1#0x}" saved ap a cls
  [[ "$to" =~ ^[0-9a-f]+$ ]] || return 0
  saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved"); a="${ap%%|*}"
  [ -n "$a" ] && [ -n "$to" ] && [ "${a#0x}" != "$to" ] || return 0
  [ "$(state_of "$ap")" = "visible" ] || return 0
  cls=$(window_field "0x$to" class)
  [[ "$cls" =~ $X_CLASS || "$cls" == *portal* ]] && return 0
  hide_window "$ap"
}

# ---- keybind self-install ---------------------------------------------------
# Omarchy has no plugin-keybind registration, so we install one ourselves the
# same way the control-panel does: a generated Lua file required LAST from
# hyprland.lua (wins load order over the default SUPER+SHIFT+X webapp bind).
# Idempotent; hyprctl reload only happens on first install. G12: every write is
# mktemp+mv in the same dir, every read is timeout+capped.
ensure_keybind() {
  local hypr_dir="$HOME/.config/hypr"
  local lua="$hypr_dir/x-panel-bindings.lua"
  local main="$hypr_dir/hyprland.lua"
  [ -d "$hypr_dir" ] || return 0
  local tmp; tmp=$(mktemp -p "$hypr_dir") || return 0
  cat > "$tmp" <<EOF
-- Auto-generated by omarchy-x-panel. Binds SUPER+SHIFT+X to the persistent
-- panel toggle (replaces the default X webapp bind, which relaunches a fresh
-- window each time). Delete this file and remove require("hypr.x-panel-bindings")
-- from hyprland.lua to restore the default.
hl.unbind("SUPER + SHIFT + X")
o.bind("SUPER + SHIFT + X", "X Panel", "$PLUGIN_DIR/bin/omarchy-x-panel toggle")
EOF
  if cmp -s "$tmp" "$lua" 2>/dev/null; then rm -f "$tmp"; else mv -f "$tmp" "$lua"; fi
  [ -f "$main" ] || return 0
  # Safe, complete read (rejects symlinks/special files and >256 KiB configs).
  local cur; cur=$(read_file_safe "$main")
  [ -n "$cur" ] || return 0
  printf '%s' "$cur" | grep -qs 'require("hypr.x-panel-bindings")' && return 0
  # Append ONE line, preserving the ENTIRE original file (no truncation).
  local tmp2; tmp2=$(mktemp -p "$hypr_dir") || return 0
  { printf '%s\n' "$cur"; printf '\nrequire("hypr.x-panel-bindings")\n'; } > "$tmp2" \
    && mv -f "$tmp2" "$main"
  # No hyprctl reload: Hyprland auto-reloads hyprland.lua on write.
}

remove_keybind() {
  local hypr_dir="$HOME/.config/hypr"
  local lua="$hypr_dir/x-panel-bindings.lua"
  local main="$hypr_dir/hyprland.lua"
  # ORDER MATTERS: drop the require FIRST, then the file, so the auto-reload
  # never evaluates hyprland.lua while it still requires a missing module.
  if [ -f "$main" ]; then
    local cur; cur=$(read_file_safe "$main")
    if [ -n "$cur" ] && printf '%s' "$cur" | grep -qs 'require("hypr.x-panel-bindings")'; then
      local tmp; tmp=$(mktemp -p "$hypr_dir") || return 0
      # Remove exactly the generated line, preserving everything else.
      printf '%s\n' "$cur" | grep -v 'require("hypr.x-panel-bindings")' > "$tmp" \
        && mv -f "$tmp" "$main"
    fi
  fi
  rm -f "$lua"
}

bind_status() { [ -f "$HOME/.config/hypr/x-panel-bindings.lua" ] && echo enabled || echo disabled; }

bind_toggle() {
  if [ -f "$HOME/.config/hypr/x-panel-bindings.lua" ]; then
    remove_keybind
  else
    ensure_keybind
  fi
}

main() {
  local saved ap st
  saved=$(read_file_safe "$STATE" | tr -d '[:space:]')
  ap=$(resolve "$saved")
  if [ -z "$ap" ]; then rm -f "$STATE"; launch_or_reuse; return; fi
  write_state "$ap"
  st=$(state_of "$ap")
  case "$st" in
    gone)   launch_or_reuse ;;
    hidden) show_window "$ap" ;;
    visible) hide_window "$ap" ;;
  esac
}

migrate_prefs

case "${1:-toggle}" in
  install-bind) ensure_keybind ;;
  uninstall-bind) remove_keybind ;;
  bind-toggle) bind_toggle ;;
  bind-status) bind_status ;;
  unread-count) unread_count ;;
  reload)
    # Manual reload: show the panel if hidden, focus it, then reload.
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    if [ -n "$ap" ]; then
      case "$(state_of "$ap")" in
        hidden) write_state "$ap"; rm -f "$HIDDEN_AT" "$PENDING"; show_window "$ap" ;;
        visible) hl_focus "${ap%%|*}" ;;
        *) exit 1 ;;
      esac
      sleep 0.1
      reload_window "${ap%%|*}"
    fi
    ;;
  focused)
    # The widget saw the panel gain focus: run a reload the watchdog flagged.
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    [ -n "$ap" ] && reload_if_pending "${ap%%|*}"
    ;;
  get-prefs)
    # Effective prefs for the focused monitor, so the preferences panel shows
    # that monitor's size.
    mk=$(focused_monitor_key)
    read_prefs | jq -c --arg m "$mk" '. + (.monitors[$m] // {}) | del(.monitors) | .monitor = $m'
    ;;
  geom) geom_json ;;
  set-size) set_size "${2:-}" "${3:-}" ;;
  hide-if-blurred) hide_if_blurred "${2:-}" ;;
  watchdog) watchdog ;;
  toggle) main ;;
  show)
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    if [ -z "$ap" ]; then launch_or_reuse; else write_state "$ap"; show_window "$ap"; fi
    ;;
  hide)
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    [ -n "$ap" ] && hide_window "$ap"
    ;;
  is-visible)
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    [ -n "$ap" ] && [ "$(state_of "$ap")" = "visible" ] && exit 0 || exit 1
    ;;
  close)
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    if [ -n "$ap" ]; then a="${ap%%|*}"; hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null 2>&1; fi
    rm -f "$STATE"
    ;;
  set-pref)
    key="$2"; val="$3"
    if [ -z "$key" ] || [ -z "$val" ]; then echo "usage: set-pref <key> <json-value>" >&2; exit 1; fi
    case "$key" in
      width|height) write_monitor_size "$(focused_monitor_key)" "$key" "$val" ;;
      *) write_prefs "$key" "$val" ;;
    esac
    # Only layout prefs need the window shown and re-placed.
    case "$key" in side|valign|width|height) ;; *) exit 0 ;; esac
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    if [ -z "$ap" ]; then
      launch_or_reuse   # window was closed: launch and show it
    else
      write_state "$ap"
      if [ "$(state_of "$ap")" = "gone" ]; then
        launch_or_reuse
      else
        # Always make the window visible so the user can preview the change,
        # but do NOT steal focus (so the preferences panel stays open). The
        # panel is layer-shell (always on top), so the X window simply sits
        # BEHIND it in its chosen position — no offset needed.
        if [ "$(state_of "$ap")" != "visible" ]; then reveal_window "$ap"; fi
        apply_layout "$ap"
      fi
    fi
    ;;
  prefs-open)
    # Make the X window visible (behind the always-on-top prefs panel) so the
    # user can preview changes without the panel stealing focus.
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    if [ -n "$ap" ]; then
      write_state "$ap"
      if [ "$(state_of "$ap")" = "gone" ]; then launch_or_reuse
      else
        if [ "$(state_of "$ap")" != "visible" ]; then reveal_window "$ap"; fi
        apply_layout "$ap"
      fi
    fi
    ;;
  prefs-close)
    # Restore the X window to its normal position.
    saved=$(read_file_safe "$STATE" | tr -d '[:space:]'); ap=$(resolve "$saved")
    if [ -n "$ap" ]; then
      write_state "$ap"
      [ "$(state_of "$ap")" = "gone" ] && launch_or_reuse || apply_layout "$ap"
    fi
    ;;
  *) main ;;
esac
